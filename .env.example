# ============================================================================
# PESATRIX Open Education Infrastructure — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Application -----------------------------------------------------------
OE_APP_NAME=pesatrix-open-education-infrastructure
OE_ENV=development
OE_DEBUG=false
OE_SECRET_KEY=change-me-generate-with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Database --------------------------------------------------------------
# Local docker-compose defaults are shown. Override for production.
OE_DATABASE_URL=postgresql+asyncpg://oe:oe@localhost:5432/oe

# --- Auth / JWT ------------------------------------------------------------
OE_JWT_EXPIRES_MINUTES=15
OE_JWT_REFRESH_EXPIRES_DAYS=14

# --- Sync ------------------------------------------------------------------
OE_SYNC_BATCH_SIZE=200
OE_SYNC_IDEMPOTENCY_TTL_SECONDS=604800

# --- Rate limiting ---------------------------------------------------------
OE_RATE_LIMIT_ENABLED=true
OE_RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins. Empty means same-origin only.
OE_CORS_ORIGINS=

# --- Logging ----------------------------------------------------------------
OE_LOG_LEVEL=INFO